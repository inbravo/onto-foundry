    ins:numerator 120000.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.2667 .

<http://ontology-foundry.io/insurance/data#LR-Marine-2026Q3-Incurred> a ins:LossRatioRecord ;
    ins:denominator 1500000.00 ;
    ins:forLine ins:LoB_Marine ;
    ins:measuredAs ins:LRV_Incurred ;
    ins:numerator 700000.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.4667 .

<http://ontology-foundry.io/insurance/data#LR-Marine-2026Q3-Paid> a ins:LossRatioRecord ;
    ins:denominator 1500000.00 ;
    ins:forLine ins:LoB_Marine ;
    ins:measuredAs ins:LRV_Paid ;
    ins:numerator 565000.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.3767 .

<http://ontology-foundry.io/insurance/data#LR-Marine-2026Q3-Ultimate> a ins:LossRatioRecord ;
    ins:denominator 1500000.00 ;
    ins:forLine ins:LoB_Marine ;
    ins:measuredAs ins:LRV_Ultimate ;
    ins:numerator 730000.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.4867 .

<http://ontology-foundry.io/insurance/data#LR-Property-2026Q3-Incurred> a ins:LossRatioRecord ;
    ins:denominator 1875000.00 ;
    ins:forLine ins:LoB_Property ;
    ins:measuredAs ins:LRV_Incurred ;
    ins:numerator 1200000.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.6400 .

<http://ontology-foundry.io/insurance/data#LR-Property-2026Q3-Paid> a ins:LossRatioRecord ;
    ins:denominator 1875000.00 ;
    ins:forLine ins:LoB_Property ;
    ins:measuredAs ins:LRV_Paid ;
    ins:numerator 800000.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.4267 .

<http://ontology-foundry.io/insurance/data#LR-Property-2026Q3-Ultimate> a ins:LossRatioRecord ;
    ins:denominator 1875000.00 ;
    ins:forLine ins:LoB_Property ;
    ins:measuredAs ins:LRV_Ultimate ;
    ins:numerator 1200000.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.6400 .

ins:caseReserve a owl:DatatypeProperty ;
    rdfs:domain ins:Claim ;
    rdfs:range xsd:decimal .

ins:coveredBy a owl:ObjectProperty ;
    rdfs:label "coveredBy" ;
    rdfs:domain ins:Claim ;
    rdfs:range ins:Policy .

ins:earnedPremium a owl:DatatypeProperty ;
    rdfs:domain ins:Policy ;
    rdfs:range xsd:decimal .

ins:forLine a owl:ObjectProperty ;
    rdfs:label "forLine" ;
    rdfs:domain ins:LossRatioRecord ;
    rdfs:range ins:LineOfBusiness .

ins:hasLoBusiness a owl:ObjectProperty ;
    rdfs:label "hasLoBusiness" ;
    rdfs:domain ins:Policy ;
    rdfs:range ins:LineOfBusiness .

ins:measuredAs a owl:ObjectProperty ;
    rdfs:label "measuredAs" ;
    rdfs:domain ins:LossRatioRecord ;
    rdfs:range ins:LossRatioVariant .

ins:paidLoss a owl:DatatypeProperty ;
    rdfs:domain ins:Claim ;
    rdfs:range xsd:decimal .

ins:period a owl:DatatypeProperty ;
    rdfs:domain ins:LossRatioRecord ;
    rdfs:range xsd:string .

ins:ratioValue a owl:DatatypeProperty ;
    rdfs:domain ins:LossRatioRecord ;
    rdfs:range xsd:decimal .

<http://ontology-foundry.io/insurance/data#P-INS-02> a ins:Party ;
    ins:policyId "P-INS-02" .

<http://ontology-foundry.io/insurance/data#P-INS-03> a ins:Party ;
    ins:policyId "P-INS-03" .

<http://ontology-foundry.io/insurance/data#POL-LIB-001> a ins:Policy ;
    ins:earnedPremium 600000.0 ;
    ins:hasInsured <http://ontology-foundry.io/insurance/data#P-INS-03> ;
    ins:hasLoBusiness ins:LoB_Liability ;
    ins:inceptionDate "2026-01-01"^^xsd:date ;
    ins:policyId "POL-LIB-001" .

<http://ontology-foundry.io/insurance/data#POL-MAR-002> a ins:Policy ;
    ins:earnedPremium 800000.0 ;
    ins:hasInsured <http://ontology-foundry.io/insurance/data#P-INS-01> ;
    ins:hasLoBusiness ins:LoB_Marine ;
    ins:inceptionDate "2026-04-01"^^xsd:date ;
    ins:policyId "POL-MAR-002" .

<http://ontology-foundry.io/insurance/data#POL-PRP-001> a ins:Policy ;
    ins:earnedPremium 2500000.0 ;
    ins:hasInsured <http://ontology-foundry.io/insurance/data#P-INS-02> ;
    ins:hasLoBusiness ins:LoB_Property ;
    ins:inceptionDate "2026-01-01"^^xsd:date ;
    ins:policyId "POL-PRP-001" .

<http://ontology-foundry.io/insurance/data#P-INS-01> a ins:Party ;
    ins:policyId "P-INS-01" .

<http://ontology-foundry.io/insurance/data#POL-MAR-001> a ins:Policy ;
    ins:earnedPremium 1200000.0 ;
    ins:hasInsured <http://ontology-foundry.io/insurance/data#P-INS-01> ;
    ins:hasLoBusiness ins:LoB_Marine ;
    ins:inceptionDate "2026-01-01"^^xsd:date ;
    ins:policyId "POL-MAR-001" .

ins:LRV_Incurred a ins:LossRatioVariant ;
    skos:definition "(Paid + case reserve) ÷ earned premium." ;
    skos:prefLabel "Incurred" .

ins:LRV_Paid a ins:LossRatioVariant ;
    skos:definition "Paid losses ÷ earned premium." ;
    skos:prefLabel "Paid" .

ins:LRV_Ultimate a ins:LossRatioVariant ;
    skos:definition "(Incurred + IBNR) ÷ earned premium." ;
    skos:prefLabel "Ultimate" .

ins:LoB_Liability a ins:LineOfBusiness ;
    skos:prefLabel "Liability" .

ins:LoB_Property a ins:LineOfBusiness ;
    skos:prefLabel "Property" .

ins:Party a owl:Class ;
    rdfs:label "Party" ;
    skos:definition "Any legal or natural person in an insurance contract." .

ins:LoB_Marine a ins:LineOfBusiness ;
    skos:prefLabel "Marine" .

ins:LineOfBusiness a owl:Class ;
    rdfs:label "LineOfBusiness" .

ins:LossRatioVariant a owl:Class ;
    rdfs:label "LossRatioVariant" ;
    skos:definition "Distinguishes how losses and premiums are measured." .

ins:Policy a owl:Class ;
    rdfs:label "Policy" ;
    skos:definition "A contract of insurance between an insurer and an insured." .

ins:Claim a owl:Class ;
    rdfs:label "Claim" ;
    skos:definition "A formal request for payment under a policy." .

ins:LossRatioRecord a owl:Class ;
    rdfs:label "LossRatioRecord" ;
    skos:definition "Computed loss ratio for a line-of-business / period cohort." .

