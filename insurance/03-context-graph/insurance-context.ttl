    ins:caseReserve 55000.0 ;
    ins:claimId "CLM-003" ;
    ins:claimStatus "Open" ;
    ins:coveredBy <http://ontology-foundry.io/insurance/data#POL-MAR-002> ;
    ins:ibnrReserve 30000.0 ;
    ins:paidLoss 95000.0 .

