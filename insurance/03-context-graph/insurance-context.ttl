    ins:caseReserve 400000.0 ;
    ins:claimId "CLM-004" ;
    ins:claimStatus "Open" ;
    ins:coveredBy <http://ontology-foundry.io/insurance/data#POL-PRP-001> ;
    ins:ibnrReserve 0.0 ;
    ins:paidLoss 800000.0 .

<http://ontology-foundry.io/insurance/data#CLM-005> a ins:Claim ;
    ins:caseReserve 0.0 ;
    ins:claimId "CLM-005" ;
    ins:claimStatus "IBNR" ;
    ins:coveredBy <http://ontology-foundry.io/insurance/data#POL-LIB-001> ;
    ins:ibnrReserve 120000.0 ;
    ins:paidLoss 0.0 .

<http://ontology-foundry.io/insurance/data#LR-Liability-2026Q3-Incurred> a ins:LossRatioRecord ;
    ins:denominator 450000.00 ;
    ins:forLine ins:LoB_Liability ;
    ins:measuredAs ins:LRV_Incurred ;
    ins:numerator 0.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.0000 .

<http://ontology-foundry.io/insurance/data#LR-Liability-2026Q3-Paid> a ins:LossRatioRecord ;
    ins:denominator 450000.00 ;
    ins:forLine ins:LoB_Liability ;
    ins:measuredAs ins:LRV_Paid ;
    ins:numerator 0.0 ;
    ins:period "2026-Q3" ;
    ins:ratioValue 0.0000 .

<http://ontology-foundry.io/insurance/data#LR-Liability-2026Q3-Ultimate> a ins:LossRatioRecord ;
    ins:denominator 450000.00 ;
    ins:forLine ins:LoB_Liability ;
