@prefix ins: <http://ontology-foundry.io/insurance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ins: a owl:Ontology ;
    rdfs:label "Insurance Core Ontology" ;
    rdfs:comment "OWL 2 ontology for loss ratio analysis. Wave 1." .

ins:ClaimShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path ins:coveredBy ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path ins:paidLoss ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path ins:caseReserve ] ;
    sh:targetClass ins:Claim .

ins:LRV_Attritional a ins:LossRatioVariant ;
    skos:definition "Excludes catastrophe events." ;
    skos:prefLabel "Attritional" .

ins:LRV_Net a ins:LossRatioVariant ;
    skos:definition "After reinsurance recovery." ;
    skos:prefLabel "Net" .

ins:LoB_Motor a ins:LineOfBusiness ;
    skos:prefLabel "Motor" .

ins:LossRatioShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path ins:period ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path ins:ratioValue ],
        [ sh:minCount 1 ;
            sh:path ins:measuredAs ],
        [ sh:minCount 1 ;
            sh:path ins:forLine ] ;
    sh:targetClass ins:LossRatioRecord .

ins:PolicyShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:path ins:earnedPremium ],
        [ sh:minCount 1 ;
            sh:path ins:hasLoBusiness ] ;
    sh:targetClass ins:Policy .

ins:claimId a owl:DatatypeProperty ;
    rdfs:domain ins:Claim ;
    rdfs:range xsd:string .

ins:claimStatus a owl:DatatypeProperty ;
    rdfs:domain ins:Claim ;
    rdfs:range xsd:string .

ins:denominator a owl:DatatypeProperty ;
    rdfs:domain ins:LossRatioRecord ;
    rdfs:range xsd:decimal .

ins:hasInsured a owl:ObjectProperty ;
    rdfs:label "hasInsured" ;
    rdfs:domain ins:Policy ;
    rdfs:range ins:Party .

ins:ibnrReserve a owl:DatatypeProperty ;
    rdfs:domain ins:Claim ;
    rdfs:range xsd:decimal .

ins:inceptionDate a owl:DatatypeProperty ;
    rdfs:domain ins:Policy ;
    rdfs:range xsd:date .

ins:numerator a owl:DatatypeProperty ;
    rdfs:domain ins:LossRatioRecord ;
    rdfs:range xsd:decimal .

ins:policyId a owl:DatatypeProperty ;
    rdfs:domain ins:Policy ;
    rdfs:range xsd:string .

